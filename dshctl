#!/usr/bin/env bash
# =============================================================================
# dshctl — DeepSeek Harness 运行时管理器 (macOS)
#
# 官方 Runtime (dsh web) 的按需生命周期管理:
#   install / start / stop / restart / status / logs / open / update / doctor
#   watch / agent-install / agent-uninstall
#
# 设计原则:
#   * 官方 dsh 零修改、零 fork,仅从 npm 固定版本安装
#   * Node 运行时独立固定于 DSH_RT_HOME,与系统 Node / nvm 完全隔离
#   * 按需启动:不用时不占任何进程,退出后无残留
#   * 健康检查 = HTTP 200,与浏览器判断一致
#   * UI 使用官方 Web App 的 Safari Web App (PWA),本脚本只负责生命周期
#
# 环境变量(均可覆盖):
#   DSH_RT_HOME / DSH_RT_STATE / DSH_RT_PORT / DSH_RT_HOST
#   DSH_RT_NODE_VERSION / DSH_RT_DSH_VERSION / DSH_HOME
# =============================================================================
set -euo pipefail

# ------------------------------- 可配置常量 ----------------------------------
RT_HOME="${DSH_RT_HOME:-$HOME/.local/share/dsh-runtime}"
RT_STATE="${DSH_RT_STATE:-$HOME/.local/state/dsh-runtime}"
DSH_HOME="${DSH_HOME:-$HOME/.dsh}"
HOST="${DSH_RT_HOST:-127.0.0.1}"
PORT="${DSH_RT_PORT:-3080}"

NODE_VERSION="${DSH_RT_NODE_VERSION:-24.19.0}"
DSH_VERSION="${DSH_RT_DSH_VERSION:-0.1.0-rc.6}"

NODE_DIR="$RT_HOME/node"
APP_DIR="$RT_HOME/app"
NODE_BIN="$NODE_DIR/bin/node"
NPM_BIN="$NODE_DIR/bin/npm"
DSH_BIN="$APP_DIR/node_modules/@deepseek-ai/dsh/lib/bin.js"

PID_FILE="$RT_STATE/dsh.pid"
LOG_DIR="$RT_STATE/logs"
LOG_FILE="$LOG_DIR/dsh.log"
AGENT_LABEL="com.dsh-launcher.runtime"
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"

log()  { printf '%s\n' "$*" >&2; }
info() { printf '%s\n' "$*"; }

usage() {
  cat <<'EOF'
dshctl — DeepSeek Harness 运行时管理器 (macOS)

用法:
  dshctl install            安装固定版本的 Node + 官方 dsh(幂等)
  dshctl start              按需启动 dsh web,等待就绪(已运行则直接返回)
  dshctl stop               停止运行时并等待端口释放
  dshctl restart            重启运行时
  dshctl status             运行状态 (0=运行中, 1=未运行)
  dshctl open               确保运行中,然后打开 Safari Web App(或浏览器)
  dshctl logs [-f] [N]      查看日志(N=行数, -f=跟随)
  dshctl update [version]   升级 dsh 到指定版本(默认 npm latest)
  dshctl doctor             环境体检
  dshctl watch              守护循环:掉线自动重启(供 launchd 使用)
  dshctl agent-install      安装 LaunchAgent(登录自启 + 崩溃自愈)
  dshctl agent-uninstall    卸载 LaunchAgent

环境变量:
  DSH_RT_PORT=3080          监听端口(默认 3080)
  DSH_RT_NODE_VERSION       固定 Node 版本(默认 24.19.0 LTS)
  DSH_RT_DSH_VERSION        固定 dsh 版本(默认 0.1.0-rc.6)
  DSH_RT_NO_OPEN=1          禁止 open 命令调用 open(供 CI 使用)
EOF
}

# ------------------------------- 基础工具 ------------------------------------
_arch() { uname -m | sed 's/x86_64/x64/; s/arm64/arm64/'; }

_url() { printf 'http://%s:%s' "$HOST" "$PORT"; }

_healthy() { curl -fsS --max-time 2 "$(_url)/" >/dev/null 2>&1; }

_pid_alive() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

_ensure_dirs() { mkdir -p "$RT_HOME" "$RT_STATE" "$LOG_DIR"; }

_wait_ready() {
  # 等待 HTTP 就绪,最多 $1 秒;成功返回 0
  local timeout="${1:-120}" i=0 log="${2:-}"
  while [ "$i" -lt "$((timeout * 2))" ]; do
    if _healthy; then
      if [ -n "$log" ]; then ln -sfn "$log" "$LOG_FILE" 2>/dev/null || true; fi
      return 0
    fi
    # 进程已死说明启动失败,快速报错
    if ! _pid_alive && [ "$i" -gt 10 ]; then
      log "启动失败,最近日志:"
      tail -n 20 "$LOG_DIR"/dsh-*.log 2>/dev/null >&2 || true
      return 1
    fi
    i=$((i + 1))
    sleep 0.5
  done
  log "等待就绪超时 (${timeout}s)"
  return 1
}

# ------------------------------- install -------------------------------------
cmd_install() {
  _ensure_dirs
  _install_node
  _install_dsh
  _persist_versions
  info ""
  info "安装完成:"
  info "  Node $NODE_VERSION  → $NODE_DIR"
  info "  dsh  $DSH_VERSION   → $APP_DIR"
  info "现在运行 'dshctl start' 即可启动"
}

_install_node() {
  if [ -x "$NODE_BIN" ] && [ "$("$NODE_BIN" -v 2>/dev/null || true)" = "v$NODE_VERSION" ]; then
    info "Node v$NODE_VERSION 已就绪,跳过下载"
    return 0
  fi
  local arch tarball url shasums tmp
  arch="$(_arch)"
  tarball="node-v$NODE_VERSION-darwin-$arch.tar.gz"
  url="https://nodejs.org/dist/v$NODE_VERSION/$tarball"
  shasums="https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt"
  tmp="$(mktemp -d /tmp/dshctl-node.XXXXXX)"
  info "下载 Node v$NODE_VERSION ($arch) ..."
  curl -fSL --max-time 900 -o "$tmp/$tarball" "$url"
  curl -fSL --max-time 60  -o "$tmp/SHASUMS256.txt" "$shasums"
  (cd "$tmp" && grep "  $tarball$" SHASUMS256.txt | shasum -a 256 -c -)
  rm -rf "$NODE_DIR"
  mkdir -p "$NODE_DIR"
  tar -xzf "$tmp/$tarball" -C "$NODE_DIR" --strip-components=1
  rm -rf "$tmp"
  info "Node v$NODE_VERSION 安装完成 ($NODE_DIR)"
}

_install_dsh() {
  if [ -f "$DSH_BIN" ]; then
    local cur
    cur="$("$NODE_BIN" "$DSH_BIN" --version 2>/dev/null || true)"
    if [ "$cur" = "$DSH_VERSION" ]; then
      info "dsh $DSH_VERSION 已就绪,跳过安装"
      return 0
    fi
    info "检测到 dsh $cur,升级到 $DSH_VERSION ..."
  else
    info "安装 dsh $DSH_VERSION (首次约 1~3 分钟)..."
  fi
  mkdir -p "$APP_DIR"
  printf '{\n  "name": "dsh-runtime-app",\n  "private": true,\n  "dependencies": {\n    "@deepseek-ai/dsh": "%s"\n  }\n}\n' "$DSH_VERSION" > "$APP_DIR/package.json"
  ( cd "$APP_DIR" && PATH="$NODE_DIR/bin:$PATH" "$NPM_BIN" install --no-audit --no-fund --loglevel=error )
  info "dsh $DSH_VERSION 安装完成 ($APP_DIR)"
}

_persist_versions() {
  # 持久化本次选择的版本,下次 install 沿用(环境变量仍可覆盖)
  printf 'NODE_VERSION=%s\nDSH_VERSION=%s\n' "$NODE_VERSION" "$DSH_VERSION" > "$RT_HOME/versions.env"
}

# ------------------------------- lifecycle -----------------------------------
cmd_start() {
  if _healthy; then
    info "DeepSeek Harness 已在运行: $(_url)"
    return 0
  fi
  if [ ! -x "$NODE_BIN" ] || [ ! -f "$DSH_BIN" ]; then
    info "首次使用,先安装运行时 (Node $NODE_VERSION + dsh $DSH_VERSION)..."
    cmd_install
  fi
  _ensure_dirs
  local stamp log
  stamp="$(date +%Y%m%d-%H%M%S)"
  log="$LOG_DIR/dsh-$stamp.log"
  info "启动 dsh web (host=$HOST port=$PORT),日志: $log"
  (
    PATH="$NODE_DIR/bin:$PATH" DSH_HOME="$DSH_HOME" \
      nohup "$NODE_BIN" "$DSH_BIN" web --host "$HOST" --port "$PORT" \
      >>"$log" 2>&1 &
    echo $! > "$PID_FILE"
  )
  if _wait_ready 120 "$log"; then
    info "已就绪: $(_url)"
    info "提示: 首次使用请用 Safari 打开上面的地址完成配置"
    info "       然后 文件 → 添加到程序坞,以后即可从 Dock 全屏启动 (见 docs/pwa-setup.md)"
    return 0
  fi
  rm -f "$PID_FILE"
  return 1
}

cmd_stop() {
  local pid="" i=0
  if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  fi
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    info "停止运行时 (pid $pid) ..."
    kill "$pid" 2>/dev/null || true
  fi
  while _healthy && [ "$i" -lt 60 ]; do
    i=$((i + 1))
    sleep 0.5
  done
  if _healthy; then
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      log "正常退出超时,强杀 (pid $pid)"
      kill -9 "$pid" 2>/dev/null || true
      sleep 1
    fi
  fi
  rm -f "$PID_FILE"
  if _healthy; then
    log "警告: 端口 $PORT 仍有服务响应,可能由其它进程提供"
    return 1
  fi
  info "已停止"
}

cmd_restart() { cmd_stop || true; cmd_start; }

cmd_status() {
  if _healthy; then
    local pid=""
    [ -f "$PID_FILE" ] && pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    info "状态: 运行中"
    info "URL:   $(_url)"
    [ -n "$pid" ] && info "PID:   $pid"
    info "Node:  $("$NODE_BIN" -v 2>/dev/null || echo 未安装)"
    info "dsh:   $("$NODE_BIN" "$DSH_BIN" --version 2>/dev/null || echo 未安装)"
    return 0
  fi
  info "状态: 未运行"
  [ -d "$RT_HOME" ] || info "提示: 尚未安装,运行 'dshctl install'"
  return 1
}

cmd_open() {
  cmd_start || return 1
  if [ "${DSH_RT_NO_OPEN:-0}" = "1" ]; then
    info "跳过 open (DSH_RT_NO_OPEN=1)"
    return 0
  fi
  local pwa=""
  for p in "$HOME/Applications/DeepSeek Harness.app" "/Applications/DeepSeek Harness.app"; do
    if [ -d "$p" ]; then pwa="$p"; break; fi
  done
  if [ -n "$pwa" ]; then
    info "打开 Safari Web App: $pwa"
    open "$pwa"
  else
    info "未找到 'DeepSeek Harness' Web App,改用 Safari 打开(建议按 docs/pwa-setup.md 添加到程序坞)"
    open "$(_url)"
  fi
}

# ------------------------------- logs / update / doctor ----------------------
cmd_logs() {
  local target="" follow=0 lines=100
  while [ $# -gt 0 ]; do
    case "$1" in
      -f) follow=1 ;;
      *)  lines="$1" ;;
    esac
    shift
  done
  if [ -f "$LOG_FILE" ]; then target="$LOG_FILE"; fi
  if [ -z "$target" ]; then
    # shellcheck disable=SC2012 # 需按 mtime 取最新日志(BSD find 无 -printf,ls -t 是 macOS 上的标准做法)
    target="$(ls -t "$LOG_DIR"/dsh-*.log 2>/dev/null | head -1 || true)"
  fi
  if [ -z "$target" ] || [ ! -f "$target" ]; then
    log "还没有日志(运行时从未启动过)"
    return 1
  fi
  if [ "$follow" = "1" ]; then exec tail -f "$target"; fi
  info "$target"
  tail -n "$lines" "$target"
}

cmd_update() {
  local want="${1:-}"
  if [ -z "$want" ]; then
    if [ ! -x "$NODE_BIN" ] || [ ! -f "$DSH_BIN" ]; then
      log "尚未安装运行时,先运行 dshctl install"
      return 1
    fi
    info "查询 npm 上 @deepseek-ai/dsh 最新版本 ..."
    want="$(PATH="$NODE_DIR/bin:$PATH" "$NPM_BIN" view @deepseek-ai/dsh version 2>/dev/null | tail -1 || true)"
    [ -n "$want" ] || { log "查询失败,请检查网络或手动指定版本: dshctl update <version>"; return 1; }
  fi
  info "更新 dsh → $want ..."
  DSH_VERSION="$want" _install_dsh
  _persist_versions
  info "完成。重启运行时生效: dshctl restart"
}

cmd_doctor() {
  info "== dshctl doctor =="
  info "RT_HOME    : $RT_HOME"
  info "RT_STATE   : $RT_STATE"
  info "DSH_HOME   : $DSH_HOME"
  info "URL        : $(_url)"
  if [ -x "$NODE_BIN" ]; then
    info "Node       : $("$NODE_BIN" -v)  @ $NODE_DIR"
  else
    info "Node       : 未安装 (运行 dshctl install)"
  fi
  if [ -f "$DSH_BIN" ]; then
    info "dsh        : $("$NODE_BIN" "$DSH_BIN" --version)  @ $APP_DIR"
  else
    info "dsh        : 未安装"
  fi
  if _healthy; then
    info "端口 $PORT  : 健康 (HTTP 200)"
  else
    info "端口 $PORT  : 空闲"
  fi
  info "日志目录   : $LOG_DIR"
  if _pid_alive; then
    info "PID 文件   : $(cat "$PID_FILE") (存活)"
  else
    info "PID 文件   : 无存活进程"
  fi
}

# ------------------------------- watch / launchd ------------------------------
cmd_watch() {
  trap 'exit 0' TERM INT
  info "watch 模式: 每 10s 检查 $(_url),掉线自动重启 (Ctrl-C 或 launchctl bootout 退出)"
  while true; do
    if ! _healthy; then
      log "$(date '+%F %T') 运行时不在线,尝试启动 ..."
      cmd_start || log "$(date '+%F %T') 启动失败,10s 后重试"
    fi
    sleep 10
  done
}

cmd_agent_install() {
  _ensure_dirs
  local dshctl_path
  dshctl_path="$(command -v dshctl 2>/dev/null || true)"
  [ -n "$dshctl_path" ] || dshctl_path="$HOME/.local/bin/dshctl"
  [ -f "$dshctl_path" ] || { log "找不到 dshctl ($dshctl_path),请先运行 scripts/install.sh"; return 1; }
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$AGENT_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$AGENT_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$dshctl_path</string>
    <string>watch</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DSH_RT_HOME</key><string>$RT_HOME</string>
    <key>DSH_RT_STATE</key><string>$RT_STATE</string>
    <key>DSH_RT_PORT</key><string>$PORT</string>
  </dict>
  <key>StandardOutPath</key><string>$LOG_DIR/agent.log</string>
  <key>StandardErrorPath</key><string>$LOG_DIR/agent.log</string>
</dict>
</plist>
PLIST
  launchctl bootout "gui/$(id -u)" "$AGENT_PLIST" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST"
  info "LaunchAgent 已安装并加载: $AGENT_LABEL"
  info "登录后自动拉起运行时,崩溃自动重启 (KeepAlive)"
}

cmd_agent_uninstall() {
  launchctl bootout "gui/$(id -u)" "$AGENT_PLIST" 2>/dev/null || true
  rm -f "$AGENT_PLIST"
  info "LaunchAgent 已卸载"
}

# ------------------------------- dispatch -------------------------------------
case "${1:-}" in
  install)        shift; cmd_install "$@" ;;
  start)          cmd_start ;;
  stop)           cmd_stop ;;
  restart)        cmd_restart ;;
  status)         cmd_status ;;
  open)           cmd_open ;;
  logs)           shift; cmd_logs "$@" ;;
  update)         shift; cmd_update "$@" ;;
  doctor)         cmd_doctor ;;
  watch)          cmd_watch ;;
  agent-install)  cmd_agent_install ;;
  agent-uninstall) cmd_agent_uninstall ;;
  help|--help|-h) usage ;;
  *)              usage; exit 1 ;;
esac
